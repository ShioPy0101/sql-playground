{
  "number": 1,
  "slug": "team-score-summary",
  "title": "チーム別スコア集計",
  "statement": "players テーブルから、チームごとの人数と平均スコアを求めてください。平均スコアが高い順、同点の場合は team の昇順で並べます。",
  "constraints": [
    {
      "name": "行数",
      "value": "1 <= players の行数 <= 200"
    },
    {
      "name": "スコア",
      "value": "0 <= score <= 100"
    },
    {
      "name": "チーム名",
      "value": "team は英小文字のみ"
    }
  ],
  "csv": "[players]\nname,team,score\nAlice,red,82\nBob,blue,91\nChika,red,88\nDaichi,blue,76",
  "starterSql": "SELECT\n  team,\n  COUNT(*) AS members,\n  AVG(score) AS average_score\nFROM players\nGROUP BY team\nORDER BY average_score DESC, team ASC;",
  "solutionSql": "SELECT\n  team,\n  COUNT(*) AS members,\n  AVG(score) AS average_score\nFROM players\nGROUP BY team\nORDER BY average_score DESC, team ASC;",
  "expectedCsv": "team,members,average_score\nred,2,85.0\nblue,2,83.5\n",
  "tests": [
    {
      "name": "サンプル",
      "csv": "[players]\nname,team,score\nAlice,red,82\nBob,blue,91\nChika,red,88\nDaichi,blue,76",
      "expectedCsv": "team,members,average_score\nred,2,85.0\nblue,2,83.5\n"
    },
    {
      "name": "1チームのみ",
      "csv": "[players]\nname,team,score\nAoi,green,100\nRen,green,70\nMio,green,85",
      "expectedCsv": "team,members,average_score\ngreen,3,85.0\n"
    },
    {
      "name": "平均点が同じ",
      "csv": "[players]\nname,team,score\nA,red,90\nB,red,70\nC,blue,80\nD,yellow,95",
      "expectedCsv": "team,members,average_score\nyellow,1,95.0\nblue,1,80.0\nred,2,80.0\n"
    }
  ]
}
