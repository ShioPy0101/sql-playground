{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/tasks/:number/submit",
      "destination": "/api/tasks/submit?number=:number"
    },
    {
      "source": "/api/tasks/:number",
      "destination": "/api/tasks/show?number=:number"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/sqlite",
      "destination": "/index.html"
    },
    {
      "source": "/tasks/:number",
      "destination": "/index.html"
    }
  ]
}
